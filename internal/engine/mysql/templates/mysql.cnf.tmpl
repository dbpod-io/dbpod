# generated by dbpod — do not edit
[mysqld]
port                              = {{ port }}
bind-address                      = {{ bind_address }}
basedir                           = {{ basedir }}
datadir                           = {{ datadir }}
socket                            = {{ socket }}
pid-file                          = {{ pid_file }}
tmpdir                            = {{ tmpdir }}
slave_load_tmpdir                 = {{ tmpdir }}
general_log                       = off
general_log_file                  = {{ log_dir }}/general.log
slow_query_log_file               = {{ log_dir }}/slow.log
log_error                         = {{ log_dir }}/error.log
log-bin                           = {{ binlog_dir }}/mysql-bin
relay_log                         = {{ relay_dir }}/relay-bin
innodb_data_home_dir              = {{ innodb_data_dir }}
innodb_log_group_home_dir         = {{ innodb_log_dir }}
innodb_undo_directory             = {{ innodb_log_dir }}
gtid_mode                         = on
enforce_gtid_consistency          = on
server-id                         = {{ server_id }}
mysqlx                            = OFF
skip-name-resolve
